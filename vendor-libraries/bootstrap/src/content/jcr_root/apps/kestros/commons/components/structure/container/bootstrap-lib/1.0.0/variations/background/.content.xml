<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          jcr:primaryType="kes:ComponentVariationGroup"
          jcr:title="Background"
          jcr:description=""
          mutuallyExclusive="{Boolean}true">
    <bg-primary jcr:primaryType="kes:ComponentVariation"
                jcr:title="Primary"
                inline="true"/>
    <bg-secondary jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Secondary"
                  inline="true"/>
    <bg-success jcr:primaryType="kes:ComponentVariation"
                jcr:title="Success"
                inline="true"/>
    <bg-danger jcr:primaryType="kes:ComponentVariation"
               jcr:title="Danger"
               inline="true"/>
    <bg-warning jcr:primaryType="kes:ComponentVariation"
                jcr:title="Warning"
                inline="true"/>
    <bg-info jcr:primaryType="kes:ComponentVariation"
             jcr:title="Info"
             inline="true"/>
    <bg-light jcr:primaryType="kes:ComponentVariation"
              jcr:title="Light"
              inline="true"/>
    <bg-dark jcr:primaryType="kes:ComponentVariation"
             jcr:title="Dark"
             inline="true"/>
    <bg-body jcr:primaryType="kes:ComponentVariation"
             jcr:title="Body"
             inline="true"/>
    <bg-body-secondary jcr:primaryType="kes:ComponentVariation"
                       jcr:title="Body Secondary"
                       inline="true"/>
    <bg-body-tertiary jcr:primaryType="kes:ComponentVariation"
                      jcr:title="Body Tertiary"
                      inline="true"/>
</jcr:root>
