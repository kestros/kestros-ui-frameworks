<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          jcr:primaryType="kes:ComponentVariationGroup"
          jcr:title="Text Color"
          jcr:description=""
          mutuallyExclusive="{Boolean}true">
    <text-primary jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Primary"
                  inline="true"/>
    <text-secondary jcr:primaryType="kes:ComponentVariation"
                    jcr:title="Secondary"
                    inline="true"/>
    <text-success jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Success"
                  inline="true"/>
    <text-danger jcr:primaryType="kes:ComponentVariation"
                 jcr:title="Danger"
                 inline="true"/>
    <text-warning jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Warning"
                  inline="true"/>
    <text-info jcr:primaryType="kes:ComponentVariation"
               jcr:title="Info"
               inline="true"/>
    <text-light jcr:primaryType="kes:ComponentVariation"
                jcr:title="Light"
                inline="true"/>
    <text-dark jcr:primaryType="kes:ComponentVariation"
               jcr:title="Dark"
               inline="true"/>
</jcr:root>
