<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          jcr:primaryType="kes:ComponentVariationGroup"
          jcr:title="Background"
          jcr:description=""
          mutuallyExclusive="{Boolean}true">
    <text-bg-primary jcr:primaryType="kes:ComponentVariation"
                     jcr:title="Primary"
                     inline="true"/>
    <text-bg-secondary jcr:primaryType="kes:ComponentVariation"
                       jcr:title="Secondary"
                       inline="true"/>
    <text-bg-success jcr:primaryType="kes:ComponentVariation"
                     jcr:title="Success"
                     inline="true"/>
    <text-bg-danger jcr:primaryType="kes:ComponentVariation"
                    jcr:title="Danger"
                    inline="true"/>
    <text-bg-warning jcr:primaryType="kes:ComponentVariation"
                     jcr:title="Warning"
                     inline="true"/>
    <text-bg-info jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Info"
                  inline="true"/>
    <text-bg-light jcr:primaryType="kes:ComponentVariation"
                   jcr:title="Light"
                   inline="true"/>
    <text-bg-dark jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Dark"
                  inline="true"/>
</jcr:root>
