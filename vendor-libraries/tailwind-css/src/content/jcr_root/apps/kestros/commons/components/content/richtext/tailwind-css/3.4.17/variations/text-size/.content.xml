<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          jcr:primaryType="kes:ComponentVariationGroup"
          jcr:title="Text Size"
          jcr:description=""
          mutuallyExclusive="{Boolean}true">
    <text-xs jcr:primaryType="kes:ComponentVariation"
             jcr:title="Extra Small"
             inline="true"/>
    <text-sm jcr:primaryType="kes:ComponentVariation"
             jcr:title="Small"
             inline="true"/>
    <text-base jcr:primaryType="kes:ComponentVariation"
               jcr:title="Base"
               inline="true"/>
    <text-lg jcr:primaryType="kes:ComponentVariation"
             jcr:title="Large"
             inline="true"/>
    <text-xl jcr:primaryType="kes:ComponentVariation"
             jcr:title="Extra Large"
             inline="true"/>
    <text-2xl jcr:primaryType="kes:ComponentVariation"
              jcr:title="2XL"
              inline="true"/>
    <text-3xl jcr:primaryType="kes:ComponentVariation"
              jcr:title="3XL"
              inline="true"/>
    <text-4xl jcr:primaryType="kes:ComponentVariation"
              jcr:title="4XL"
              inline="true"/>
    <text-5xl jcr:primaryType="kes:ComponentVariation"
              jcr:title="5XL"
              inline="true"/>
    <text-6xl jcr:primaryType="kes:ComponentVariation"
              jcr:title="6XL"
              inline="true"/>
    <text-7xl jcr:primaryType="kes:ComponentVariation"
              jcr:title="7XL"
              inline="true"/>
    <text-8xl jcr:primaryType="kes:ComponentVariation"
              jcr:title="8XL"
              inline="true"/>
    <text-9xl jcr:primaryType="kes:ComponentVariation"
              jcr:title="9XL"
              inline="true"/>
</jcr:root>
