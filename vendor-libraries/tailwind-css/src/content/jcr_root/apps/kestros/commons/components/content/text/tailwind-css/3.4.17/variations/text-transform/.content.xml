<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          jcr:primaryType="kes:ComponentVariationGroup"
          jcr:title="Text Transform"
          jcr:description=""
          mutuallyExclusive="{Boolean}true">
    <uppercase jcr:primaryType="kes:ComponentVariation"
               jcr:title="Uppercase"
               inline="true"/>
    <lowercase jcr:primaryType="kes:ComponentVariation"
               jcr:title="Lowercase"
               inline="true"/>
    <capitalize jcr:primaryType="kes:ComponentVariation"
                jcr:title="Capitalize"
                inline="true"/>
    <normal-case jcr:primaryType="kes:ComponentVariation"
                 jcr:title="Normal Case"
                 inline="true"/>
</jcr:root>
