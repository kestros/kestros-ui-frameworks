<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          jcr:primaryType="kes:ComponentVariationGroup"
          jcr:title="Border Radius"
          jcr:description=""
          mutuallyExclusive="{Boolean}true">
    <rounded-none jcr:primaryType="kes:ComponentVariation"
                  jcr:title="None"
                  inline="true"/>
    <rounded-sm jcr:primaryType="kes:ComponentVariation"
                jcr:title="Small"
                inline="true"/>
    <rounded jcr:primaryType="kes:ComponentVariation"
             jcr:title="Default"
             inline="true"/>
    <rounded-md jcr:primaryType="kes:ComponentVariation"
                jcr:title="Medium"
                inline="true"/>
    <rounded-lg jcr:primaryType="kes:ComponentVariation"
                jcr:title="Large"
                inline="true"/>
    <rounded-xl jcr:primaryType="kes:ComponentVariation"
                jcr:title="Extra Large"
                inline="true"/>
    <rounded-2xl jcr:primaryType="kes:ComponentVariation"
                 jcr:title="2XL"
                 inline="true"/>
    <rounded-3xl jcr:primaryType="kes:ComponentVariation"
                 jcr:title="3XL"
                 inline="true"/>
    <rounded-full jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Full"
                  inline="true"/>
</jcr:root>
