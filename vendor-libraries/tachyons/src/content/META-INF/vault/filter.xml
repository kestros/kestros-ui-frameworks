<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">

  <filter root="/etc/vendor-libraries/tachyons"/>
  <filter root="/apps/kestros/commons/components">
    <!-- Match "ui-kit-lib" folders at any level under the components directory -->
    <include pattern="^/apps/kestros/commons/components(/.*/tachyons-lib(/.*)?)?$"/>
  </filter>

</workspaceFilter>
