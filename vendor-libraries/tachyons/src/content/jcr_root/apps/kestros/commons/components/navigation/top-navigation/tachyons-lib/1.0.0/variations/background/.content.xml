<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          jcr:primaryType="kes:ComponentVariationGroup"
          jcr:title="Background"
          jcr:description=""
          mutuallyExclusive="{Boolean}true">
    <bg-white jcr:primaryType="kes:ComponentVariation"
              jcr:title="White"
              inline="true"/>
    <bg-near-white jcr:primaryType="kes:ComponentVariation"
                   jcr:title="Near White"
                   inline="true"/>
    <bg-black jcr:primaryType="kes:ComponentVariation"
              jcr:title="Black"
              inline="true"/>
    <bg-near-black jcr:primaryType="kes:ComponentVariation"
                   jcr:title="Near Black"
                   inline="true"/>
    <bg-dark-gray jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Dark Gray"
                  inline="true"/>
    <bg-navy jcr:primaryType="kes:ComponentVariation"
             jcr:title="Navy"
             inline="true"/>
    <bg-dark-blue jcr:primaryType="kes:ComponentVariation"
                  jcr:title="Dark Blue"
                  inline="true"/>
</jcr:root>
