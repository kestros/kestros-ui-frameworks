<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:kes="http://kestros.io/kes/1.0"
          jcr:primaryType="kes:ComponentVariationGroup"
          jcr:title="Button Style"
          jcr:description=""
          mutuallyExclusive="{Boolean}true">
    <nova-button jcr:primaryType="kes:ComponentVariation"
                 jcr:title="Default"
                 inline="true"
                 default="true"/>
