                 jcr:title="Primary"
                 inline="true"/>
    <btn-secondary jcr:primaryType="kes:ComponentVariation"
                   jcr:title="Secondary"
                   inline="true"/>
    <btn-success jcr:primaryType="kes:ComponentVariation"
                 jcr:title="Success"
                 inline="true"/>
    <btn-danger jcr:primaryType="kes:ComponentVariation"
                jcr:title="Danger"
                inline="true"/>
    <btn-warning jcr:primaryType="kes:ComponentVariation"
                 jcr:title="Warning"
                 inline="true"/>
    <btn-info jcr:primaryType="kes:ComponentVariation"
              jcr:title="Info"
              inline="true"/>
    <btn-light jcr:primaryType="kes:ComponentVariation"
               jcr:title="Light"
               inline="true"/>
    <btn-dark jcr:primaryType="kes:ComponentVariation"
              jcr:title="Dark"
              inline="true"/>
    <btn-outline-primary jcr:primaryType="kes:ComponentVariation"
                         jcr:title="Outline Primary"
                         inline="true"/>
