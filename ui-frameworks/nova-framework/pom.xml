<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.kestros.cms</groupId>
    <artifactId>kestros-ui-frameworks-downloadable</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <groupId>io.kestros.cms</groupId>
  <artifactId>kestros-nova-framework</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <name>Kestros Nova Framework</name>
  <description>UI framework wrapping nova-css with parallax and lazy loading framework views</description>
  <packaging>bundle</packaging>

  <licenses>
    <license>
      <name>GPL-v3.0</name>
      <url>http://www.gnu.org/licenses/gpl-3.0.txt</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:git://github.com/kestros/kestros-misc-reactor.git</connection>
    <developerConnection>scm:git:ssh://github.com:kestros/kestros-misc-reactor.git</developerConnection>
    <url>https://github.com/kestros/kestros-misc-reactor/tree/master</url>
  </scm>

  <properties>
    <bundleCategory>kestros</bundleCategory>
    <skipTests>false</skipTests>
    <sonar.language>js</sonar.language>
    <sonar.sourceEncoding>UTF-8</sonar.sourceEncoding>
    <sonar.javascript.lcov.reportPaths>coverage/lcov.info</sonar.javascript.lcov.reportPaths>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.sling</groupId>
      <artifactId>org.apache.sling.scripting.sightly.runtime</artifactId>
      <version>1.0.0-1.4.0</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/content/jcr_root</directory>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Sling-Initial-Content>
              /apps/kestros/commons/components/structure/section/nova-framework;overwrite:=true;path:=/apps/kestros/commons/components/structure/section/nova-framework,
              /apps/kestros/commons/components/content/image/nova-framework;overwrite:=true;path:=/apps/kestros/commons/components/content/image/nova-framework,
              /etc/ui-frameworks;overwriteProperties:=true;path:=/etc/ui-frameworks
            </Sling-Initial-Content>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
